<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".RecordActivity">

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/milk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="우유" />

        <Button
            android:id="@+id/meal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="식사" />

        <Button
            android:id="@+id/sleep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="수면" />

        <Button
            android:id="@+id/poop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="배변" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/statisticsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:weightSum="2"
        android:background="@color/black"
        app:layout_constraintTop_toBottomOf="@id/linearLayout2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/statisticsProgress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/todayStatistics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_weight="1"
            android:background="@color/black"
            app:layout_constraintTop_toBottomOf="@id/linearLayout2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/totalMilkText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오늘 우유: 0ml"
            android:textColor="#f5a30a"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/totalMealText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#f5a30a"
            android:text="오늘 이유식: 0ml"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/totalSleepText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#f5a30a"
            android:text="오늘 수면: 0분"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/poopCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#f5a30a"
            android:text="오늘 배변: 0회"
            android:textSize="16sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/avgStatistics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_weight="1"
            android:background="@color/black"
            app:layout_constraintTop_toBottomOf="@id/linearLayout2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/avgMilkText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="평균 우유량: 0ml"
                android:textColor="#f5a30a"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/avgMealText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#f5a30a"
                android:text="평균 이유식: 0ml"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/avgSleepText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#f5a30a"
                android:text="평균 수면: 0분"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/avgPoopCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#f5a30a"
                android:text="평균 배변: 0회"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/calculationDaysText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#f5a30a"
                android:text="계산일 수: 0일"
                android:textSize="16sp" />
            <Button
                android:id="@+id/avgBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#f5a30a"
                android:textColor="@color/black"
                android:layout_marginTop="10dp"
                android:text="평균계산"/>

        </LinearLayout>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recordRc"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/statisticsLayout"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:weightSum="5">

        <Button
            android:id="@+id/diaryBtn"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="일기"/>
        <Button
            android:id="@+id/recordBtn"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="기록"/>
        <Button
            android:id="@+id/weatherBtn"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="날씨"/>
        <Button
            android:id="@+id/mapBtn"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="병원"/>
        <Button
            android:id="@+id/dDayBtn"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="접종"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
